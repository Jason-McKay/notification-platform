{
  "uid": "notification-platform",
  "id": null,
  "title": "Notification Platform",
  "description": "Requests in at the api, deliveries out of the worker, what failed, how fast, whether the worker keeps up, and both JVMs. Provisioned from observability/grafana; UI edits are not saved.",
  "tags": ["notification-platform"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Alerts in Prometheus",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 5,
      "type": "timeseries",
      "title": "Api: requests per second, by outcome",
      "description": "notification.ingress. accepted and duplicate are 202s; publish_failed is a 5xx the client should retry under the same Idempotency-Key.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accepted" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "duplicate" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "publish_failed" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum by (outcome) (rate(notification_ingress_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Worker: deliveries per second, by channel and outcome",
      "description": "notification.delivery. failed counts every failed try, so an event that dead-letters counts as failed once per try.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 9, "y": 0, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum by (channel, outcome) (rate(notification_delivery_total[$__rate_interval]))",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dead-lettered in range",
      "description": "Events that exhausted their retries in the selected time range. List them on the worker: GET /api/notifications?status=DEAD_LETTERED. increase() extrapolates to the edges of the range, so this can read one off the counter.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum(increase(notification_delivery_total{outcome=\"dead_lettered\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed tries in range",
      "description": "Every failed try in the selected time range, including the ones a retry topic gave another go. increase() extrapolates to the edges of the range, so this can read one off the counter.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum(increase(notification_delivery_total{outcome=\"failed\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Api: publish latency",
      "description": "notification.publish.duration: the awaited publish to Kafka, until the broker's ack or the failure.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(notification_publish_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(notification_publish_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker: dispatch latency, by channel",
      "description": "notification.dispatch.duration: one try at one channel, sent or failed. The NotificationDispatchSlow alert fires on a p95 above 2s.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(notification_dispatch_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{channel}} p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, channel) (rate(notification_dispatch_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{channel}} p50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker: consumer lag, by topic",
      "description": "Records the worker has yet to read, summed over partitions, as its Kafka client reports them. Retry topics hold records for their backoff, so short lag there is normal.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_lag{job=\"notification-worker\", topic=~\"notification\\\\.requested.*\"})",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Heap in use and heap committed by the JVM, per app.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\", job=~\"notification-api|notification-worker\"})",
          "legendFormat": "{{job}} used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "sum by (job) (jvm_memory_committed_bytes{area=\"heap\", job=~\"notification-api|notification-worker\"})",
          "legendFormat": "{{job}} committed"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process CPU",
      "description": "process.cpu.usage: the JVM's share of the CPU available to it, per app.",
      "datasource": { "type": "prometheus", "uid": "np-prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "np-prometheus" },
          "expr": "process_cpu_usage{job=~\"notification-api|notification-worker\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
